# ==============================================================================
# Grade Flow Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# DO NOT commit real secrets or production service keys to version control.
# ==============================================================================

# Client-Side Supabase Variables (Vite Public Scope)
# Used by frontend browser client in src/services/supabaseDatabase.ts
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Serverless & Administrative Functions Scope (Vercel Serverless Functions)
# Used by api/manage-users.ts for administrative account management
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Direct Database Connection String (Optional - for migrations and scripts)
POSTGRES_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"
